{
  "name": "@ojasss/backend",
  "version": "1.0.0",
  "description": "OJASSS backend: Postgres schema, RLS, API functions and edge functions",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:functions": "cd functions && deno check */index.ts",
    "check": "npm run typecheck && npm run check:functions && npm test"
  },
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.1",
    "deno": "^2.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "private": true
}
