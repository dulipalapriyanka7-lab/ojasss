{
  "name": "OJASSS",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/php:1": { "version": "8.3" }
  },
  "postCreateCommand": "cd web && npm ci",
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "OJASSS web", "onAutoForward": "openPreview" } },
  "customizations": { "vscode": { "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss", "Dart-Code.flutter"] } }
}
