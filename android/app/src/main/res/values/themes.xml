<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: SplashScreen API (backported to API 24 by core-splashscreen). -->
    <style name="Theme.Ojasss.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_launcher</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Ojasss</item>
    </style>

    <style name="Theme.Ojasss" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
